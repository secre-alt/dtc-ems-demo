{
  "name": "dtc-ems-demo",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "@remotion/media": "4.0.547",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.547",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.15.0",
    "playwright": "^1.65.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-manifest.mjs",
    "predev": "node scripts/ensure-manifest.mjs",
    "dev": "remotion studio",
    "prebuild": "node scripts/ensure-manifest.mjs",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "precapture": "node scripts/ensure-manifest.mjs",
    "capture": "node scripts/capture.mjs",
    "prevalidate-assets": "node scripts/ensure-manifest.mjs",
    "validate-assets": "node scripts/validate-assets.mjs",
    "precheck": "node scripts/ensure-manifest.mjs",
    "check": "npm run lint && node scripts/check-timeline.mjs && node scripts/validate-assets.mjs",
    "prerender": "node scripts/ensure-manifest.mjs",
    "render": "node scripts/render.mjs",
    "prerender:draft": "node scripts/ensure-manifest.mjs",
    "render:draft": "node scripts/render.mjs --draft",
    "sfx": "node scripts/generate-sfx.mjs",
    "record": "node scripts/generate-ui-sfx.mjs && node scripts/record.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
